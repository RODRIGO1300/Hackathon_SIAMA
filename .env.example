# Copie este archivo como .env y llene lo que vaya a usar. Todo es opcional:
# sin estas variables el prototipo funciona igual (resumen de plantilla y datos desde salidas/).
# .env está en .gitignore: nunca suba sus credenciales al repositorio.

# --- IBM watsonx.ai (asistente de IA con IBM Granite) -----------------------------------------
# API key: https://cloud.ibm.com/iam/apikeys
WATSONX_APIKEY=
# Proyecto de watsonx.ai > Administrar > General > ID del proyecto
WATSONX_PROJECT_ID=
# Región de su instancia de watsonx.ai Runtime (Dallas: us-south, Fráncfort: eu-de, Tokio: jp-tok, Londres: eu-gb...)
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Modelo Granite. Para ver los disponibles en su región:  python -m api.watsonx
WATSONX_MODEL_ID=ibm/granite-4-h-small

# --- IBM Cloud Databases for PostgreSQL -------------------------------------------------------
# Credenciales del servicio > "postgres" > composed (cambie $PASSWORD por la contraseña real)
SIAMA_DATABASE_URL=
# Certificado de la instancia: guarde el de las credenciales como archivo y ponga su ruta...
SIAMA_PG_CA_CERT=
# ...o pegue aquí el certificado en base64 tal como viene en las credenciales (certificate_base64)
SIAMA_PG_CA_CERT_B64=
